# Настройки приложения. Скопируйте этот файл как .env и подставьте свои значения.
# Файл .env в git не попадает (см. .gitignore).
#
# Реквизитов OZON здесь нет: их задаёт пользователь прямо в приложении,
# POST /api/auth/register, а потом PUT /api/marketplaces/ozon/credentials.
# В БД они хранятся у аккаунта продавца, см. TODO(#encrypt-credentials).

# Реквизиты БД из docker-compose. Меняйте, если у вас другая.
DB_URL=jdbc:postgresql://localhost:5433/analizer
DB_USERNAME=analizer
DB_PASSWORD=analizer

# Обычно менять не нужно.
OZON_BASE_URL=https://api-seller.ozon.ru
OZON_CONNECT_TIMEOUT=10s
OZON_READ_TIMEOUT=60s
OZON_MAX_RETRIES=5
OZON_RETRY_BACKOFF=2s
# Источники, которым разрешён CORS. Пусто — приложение отвечает только своему
# источнику, и это обычный режим для сервера и для проверки production-сборки.
#
# Для РЕЖИМА РАЗРАБОТКИ задайте адрес Vite: интерфейс тогда запускается отдельно
# (cd frontend && npm run dev) и применяет правки без пересборки образа. В этом
# режиме страницу нужно открывать на 5173, а не на 8080 — на 8080 отдаётся статика,
# собранная при последнем docker compose up --build, и горячих изменений там нет.
#   APP_ALLOWED_ORIGINS=http://localhost:5173
APP_ALLOWED_ORIGINS=

# Политика кук. Для публикации по HTTPS нужно None + true: браузер не принимает
# SameSite=None без Secure, и сессия терялась бы на каждом запросе.
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false