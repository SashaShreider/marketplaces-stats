# Реквизиты OZON Seller API.
# Скопируйте этот файл как .env и подставьте свои значения.
# Файл .env в git не попадает (см. .gitignore) — секрет остаётся у вас.
#
# Client-Id и Api-Key берутся в ЛК Ozon: Настройки -> Seller API -> Сгенерировать ключ.
# Нужен ключ с доступом к финансовым методам.

OZON_CLIENT_ID=1154
OZON_API_KEY=change-me

# Реквизиты БД из docker-compose. Меняйте, если у вас другая.
DB_URL=jdbc:postgresql://localhost:5433/analizer
DB_USERNAME=analizer
DB_PASSWORD=analizer